# Secrets -- never commit real credentials
secrets.json
secrets_test.json
*.secrets.json

# Project-specific mapping configs -- each is tied to one spreadsheet's
# columns, so they stay local. configs/example.yaml is the tracked template.
configs/*.yaml
!configs/example.yaml

# Spreadsheets -- source data, kept local
*.xlsx
*.xls

# Run-generated artifacts -- local bookkeeping, not source
state.json
pending_relink.json
container_cache.json
logs/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/

# OS cruft
.DS_Store
Thumbs.db
